# Server-only. The BE origin: server-side generated calls go here directly, and the
# /api/v1/* rewrite forwards browser calls here (same-origin for the browser).
API_URL=http://localhost:3000
# Server-only. The public origin, for metadataBase, robots.txt and sitemap.xml.
SITE_URL=http://localhost:3001
# Public origin of the R2 photo bucket (= BE IMAGE_PUBLIC_BASE_URL); photos under it render
# through Cloudflare Images variants. dev: https://img-dev.example.com · prod: https://img.example.com.
# Inlined into the browser bundle AT BUILD — set it before `next build`. Anything under the
# NEXT_PUBLIC_ prefix ships to every browser, so never put a secret there.
NEXT_PUBLIC_IMAGE_BASE_URL=https://img-dev.example.com
# Public origin whose /images/* sit on a Cloudflare zone with Image Transformations on (prod:
# https://example.com) → the site's own static images render as resized variants too. Leave it
# UNSET in dev/CI: there is no Cloudflare in front, so /cdn-cgi/image would 404. Inlined AT BUILD.
# NEXT_PUBLIC_STATIC_IMAGE_BASE_URL=https://example.com
