VITE_API_BASE_URL=
# Public origin of the R2 photo bucket — MUST equal the BE's IMAGE_PUBLIC_BASE_URL.
# Photos under it render through Cloudflare Images variants (/cdn-cgi/image/width=…);
# dev: https://img-dev.example.com · prod: https://img.example.com.
# Leave empty to show every photo from its stored URL unchanged.
VITE_IMAGE_BASE_URL=https://img-dev.example.com
