NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://dress:dress@localhost:5432/dress_rental
LOG_LEVEL=info
JWT_SECRET=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_SECRET=
JWT_REFRESH_TTL_SEC=2592000
CLEANING_BUFFER_DAYS=1
# FR-RENT-09: flat late fee in VND per dress per day (owner decision — see
# docs/design/rentals/settle-late-fee.md §6.Q1)
LATE_FEE_PER_DRESS_PER_DAY=200000
SEED_OWNER_USERNAME=owner
SEED_OWNER_PASSWORD=
# FR-CAT-10 photo upload (docs/design/catalog/dress-photo-upload.md §5). The BE only SIGNS a
# direct browser → R2 PUT (no network at boot). Leave ANY of the five below empty and the app
# still boots; only POST /api/v1/photos/upload-urls answers 503 PHOTO.STORAGE_UNAVAILABLE.
# R2 API token: Object Read & Write, scoped to R2_BUCKET only. Never commit real keys.
R2_ACCOUNT_ID=82fb2b83054c25108940e5e83962e839
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=dress-rental-dev-media
# Public read origin (bucket custom domain) stored in photo_urls — NOT the S3 API endpoint.
IMAGE_PUBLIC_BASE_URL=https://img-dev.example.com
# Upload size limit in bytes (default 10 MB = 10485760)
MAX_PHOTO_BYTES=10485760
