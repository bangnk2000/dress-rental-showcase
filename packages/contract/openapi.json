    "/api/v1/dresses/{dressId}/availability": {
      "get": {
        "operationId": "CheckAvailabilityHttpController_check",
        "parameters": [
          {
            "name": "dressId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "startDate",
            "required": true,
            "in": "query",
            "description": "First rental day (inclusive)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-08-10",
              "type": "string"
            }
          },
          {
            "name": "endDate",
            "required": true,
            "in": "query",
            "description": "Last rental day (inclusive)",
            "schema": {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "example": "2026-08-12",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
