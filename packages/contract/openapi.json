  "info": {
    "title": "dress-rental API",
    "description": "",
    "version": "0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "owner@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "example": "changeme"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Short-lived JWT access token (Bearer)"
          },
          "refreshToken": {
            "type": "string",
            "description": "Long-lived refresh token"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "RefreshTokenRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "MeResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "6f1e2c3a-6b1a-4e6a-9f57-0b6c2f1e2c3a"
          },
          "email": {
            "type": "string",
            "example": "owner@example.com"
          },
          "name": {
            "type": "string",
            "example": "Chị Hoa"
          },
          "role": {
            "enum": [
              "owner",
              "staff"
            ],
            "type": "string",
            "example": "owner"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "role"
        ]
      },
      "CreateDressRequestDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{1,19}$",
            "example": "VD-012",
            "description": "Unique shop code"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "example": "Váy cưới đuôi cá ren trắng"
          },
          "sizeLabel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20,
            "example": "M"
          },
          "rentalPrice": {
            "type": "number",
            "minimum": 0,
            "example": 1500000,
            "description": "Rental price in VND (integer)"
          },
          "depositAmount": {
            "type": "number",
            "minimum": 0,
            "example": 3000000,
            "description": "Standard deposit in VND (integer)"
          },
          "notes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "example": "Rách nhẹ vạt dưới, đã sửa 06/2026"
          },
          "photoUrls": {
            "maxItems": 10,
            "description": "Photo links (http/https), max 10 — no binary upload in MVP",
            "type": "array",
            "items": {
