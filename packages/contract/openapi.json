              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AvailabilityResponseDto"
                }
              }
            }
          },
          "404": {
            "description": "Dress not found"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Is the dress free for [startDate, endDate]? (cleaning buffer included)",
        "tags": [
          "rentals"
        ]
      }
    },
